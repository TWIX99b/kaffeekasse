# Vorlage für deine persönlichen Einstellungen.
# Kopieren:  cp .env.example .env   – dann in .env anpassen.
# Die .env bleibt auf deinem Server und wird nicht auf GitHub hochgeladen.

# --- Image von GitHub (für Updates per „docker compose pull“) ---
# KAFFEEKASSE_IMAGE=ghcr.io/DEIN-GITHUB-NAME/kaffeekasse
# KAFFEEKASSE_TAG=latest          # oder eine feste Version, z. B. v1.2.0

# --- Erreichbarkeit ---
PORT=8080
ADRESSE=http://kaffeekasse.lokal:8080      # erscheint auf Zugangszetteln und QR-Codes
PROXY_ANZAHL=0                             # hinter Nginx Proxy Manager, Traefik, Caddy …: 1
EINRICHTUNGS_CODE=                         # empfohlen, wenn die Seite schon vor der Einrichtung erreichbar ist

# --- Startwerte (danach in der App änderbar) ---
SHOP_NAME=Kaffeekasse
ERSTER_SHOP=Halle 1
LIMIT_EUR=30
MIN_BESTAND=5
WARN_GUTHABEN_EUR=5
DATENSCHUTZ_KONTAKT=
STIL=standard                              # Design: standard, hangar oder dashboard (später unter Einstellungen änderbar)

# --- Sicherungen ---
SICHERUNG_ORDNER=./sicherungen             # z. B. /mnt/nas/kaffeekasse
SICHERUNG_UHR=02:30
SICHERUNG_ANZAHL=30
SICHERUNG_MELDE_URL=                       # z. B. https://ntfy.sh/mein-kanal – meldet nur Fehler
